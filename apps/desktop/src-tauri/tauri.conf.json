{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Universal Context Manager",
  "version": "0.1.0",
  "identifier": "com.universalcontextmanager.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "../../scripts/prepare-sidecars.sh debug && pnpm exec vite --port 1420",
    "beforeBuildCommand": "../../scripts/prepare-sidecars.sh release && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Universal Context Manager",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first context control plane for AI coding workflows.",
    "longDescription": "Universal Context Manager keeps global, project, and task context local, reviewable, and restorable for AI coding harnesses.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
